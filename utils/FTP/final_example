from ftp_client import SFTPClient, default_logger
from ftp_pipeline import FTPPipeline
from state_manager import FileStateManager
from storage_adls import ADLSClient

logger = default_logger()

# FTP
client = SFTPClient(
    host="serafin.iberdrola.com",
    username="user",
    password="password",
    logger=logger
)

# ADLS (usar secrets en real)
adls = ADLSClient(
    account_name="mystorageaccount",
    file_system="landing",
    credential="your_sas_or_sp"
)

# Estado
state = FileStateManager("/dbfs/tmp/ftp_state.txt")

pipeline = FTPPipeline(
    client=client,
    state_manager=state,
    remote_path="FIC_FACT_AGUAS",
    storage_client=adls,
    max_workers=8
)

files = pipeline.run(extension=".xlsx")
